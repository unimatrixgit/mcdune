DISCORD_PUBLISHER_ID=
DISCORD_EXCHANGE_CHANNEL_ID=
DISCORD_NEWS_CHANNEL_ID=

# Comma-separated staff account emails; store as secrets in Sites.
FORUM_ADMIN_EMAILS=
SUPPORT_STAFF_EMAILS=

DISCORD_DIPLOMACY_CHANNEL_ID=
